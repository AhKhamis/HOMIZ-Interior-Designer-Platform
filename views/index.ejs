<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <link
    rel="stylesheet"
    href="/stylesheets/style.css"
  />

  <link
    rel="stylesheet"
    href="/stylesheets/partials.css"
  />

  <script src="https://unpkg.com/lucide@latest"></script>

  <title>HOMIZ | Interior Design</title>
</head>

<body>

  <%- include('./partials/_navbar.ejs') %>

  <main>

    <!-- =========================
         HERO
    ========================== -->

    <section class="hero">

      <div class="hero-orange">

        <div class="hero-pattern"></div>

        <img
          class="hero-chair"
          src="/stylesheets/images/blackChair.png"
          alt="Black interior chair"
        />

        <div class="hero-logo-badge">
          HOMIZ
        </div>

        <div class="hero-client-badge">

          <strong>
            +1k
          </strong>

          <span>
            happy<br />
            clients
          </span>

        </div>

      </div>


      <div class="hero-white">

        <div class="hero-content">

          <div class="hero-script">
            homiz
          </div>

          <div class="hero-kicker">
            HOMIZ INTERIOR DESIGN
          </div>

          <h1>
            Interior<br />
            Designer
          </h1>

          <p class="hero-description">
            Transform your space with creative ideas,
            professional designers and personalized
            interior solutions.
          </p>

          <div class="hero-actions">

            <a
              href="/projects"
              class="hero-primary-button"
            >
              Explore Projects
              <span>←</span>
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================
         SERVICES
    ========================== -->

    <section
      class="services-strip"
      id="services"
    >

      <div class="service-item">

        <div class="service-icon">
          <i data-lucide="pen-tool"></i>
        </div>

        <h3>
          Precision Design
        </h3>

      </div>


      <div class="service-item">

        <div class="service-icon">
          <i data-lucide="git-branch"></i>
        </div>

        <h3>
          Precise Execution
        </h3>

      </div>


      <div class="service-item">

        <div class="service-icon">
          <i data-lucide="sparkles"></i>
        </div>

        <h3>
          AI Powered
        </h3>

      </div>


      <div class="service-item">

        <div class="service-icon">
          <i data-lucide="workflow"></i>
        </div>

        <h3>
          Personalization
        </h3>

      </div>


      <div class="services-title">

        <p>
          Services at Home
        </p>

        <h2>
          HOMIZ Design
        </h2>

      </div>

    </section>


    <!-- =========================
         PROJECTS
    ========================== -->

    <section
      class="projects-section"
      id="projects"
    >

      <div class="projects-header">

        <div class="projects-arrows">

          <% if (currentPage > 1) { %>

            <a
              href="/?page=<%= currentPage - 1 %>#projects"
              class="projects-arrow"
              aria-label="Previous projects"
            >
              ←
            </a>

          <% } else { %>

            <span
              class="projects-arrow disabled"
              aria-hidden="true"
            >
              ←
            </span>

          <% } %>


          <% if (currentPage < totalPages) { %>

            <a
              href="/?page=<%= currentPage + 1 %>#projects"
              class="projects-arrow"
              aria-label="Next projects"
            >
              →
            </a>

          <% } else { %>

            <span
              class="projects-arrow disabled"
              aria-hidden="true"
            >
              →
            </span>

          <% } %>

        </div>


        <div class="projects-title">

          <p>
            OUR WORK
          </p>

          <h2>
            HOMIZ Projects
          </h2>

        </div>

      </div>


      <% if (latestProjects && latestProjects.length > 0) { %>

        <div class="projects-grid">

          <% latestProjects.forEach((project) => { %>

            <article class="project-card">

              <div class="project-info">

                <h3>
                  <%= project.title %>
                </h3>

                <p>
                  <%= project.description %>
                </p>


                <div class="project-designer">

                  <span>
                    Designer:
                  </span>

                  <% if (
                    project.designer &&
                    project.designer.user
                  ) { %>

                    <strong>
                      <%= project.designer.user.username %>
                    </strong>

                  <% } else { %>

                    <strong>
                      HOMIZ Designer
                    </strong>

                  <% } %>

                </div>


                <a
                  href="/projects/<%= project._id %>"
                  class="project-button"
                >
                  View
                  <span>←</span>
                </a>

              </div>


              <div class="project-image">

                <% if (
                  project.mainImage &&
                  project.mainImage.url
                ) { %>

                  <img
                    src="<%= project.mainImage.url %>"
                    alt="<%= project.title %>"
                  />

                <% } else { %>

                  <img
                    src="/stylesheets/images/blackChair.png"
                    alt="Project image"
                  />

                <% } %>

              </div>

            </article>

          <% }) %>

        </div>

      <% } else { %>

        <div class="no-projects">

          <h3>
            No projects yet
          </h3>

          <p>
            New interior design projects will appear here.
          </p>

        </div>

      <% } %>

    </section>


    <!-- =========================
         BLOG
    ========================== -->

    <section
      class="home-blog-section"
      id="blog"
    >

      <div class="home-blog-header">

        <div class="home-blog-title">

          <p>
            OUR STORIES
          </p>

          <h2>
            HOMIZ Blog
          </h2>

        </div>

      </div>


      <% if (latestBlogs && latestBlogs.length > 0) { %>

        <div class="home-blog-grid">


          <% if (latestBlogs[0]) { %>

            <article class="home-blog-featured">

              <div class="home-blog-featured-image">

                <% if (latestBlogs[0].image) { %>

                  <img
                    src="<%= latestBlogs[0].image %>"
                    alt="<%= latestBlogs[0].title %>"
                  />

                <% } else { %>

                  <div class="home-blog-placeholder">

                    <span>
                      HOMIZ
                    </span>

                  </div>

                <% } %>

              </div>


              <div class="home-blog-featured-content">

                <p>
                  HOMIZ BLOG
                </p>

                <h3>
                  <%= latestBlogs[0].title %>
                </h3>

                <div class="home-blog-featured-description">
                  <%= latestBlogs[0].content %>
                </div>


                <a
                  href="/blog/<%= latestBlogs[0]._id %>"
                  class="home-blog-button"
                >
                  Read Article
                  <span>↖</span>
                </a>

              </div>

            </article>

          <% } %>


          <div class="home-blog-list">

            <% latestBlogs.slice(1, 4).forEach((blog) => { %>

              <article class="home-blog-small">

                <div class="home-blog-small-image">

                  <% if (blog.image) { %>

                    <img
                      src="<%= blog.image %>"
                      alt="<%= blog.title %>"
                    />

                  <% } else { %>

                    <div class="home-blog-placeholder">

                      <span>
                        H
                      </span>

                    </div>

                  <% } %>

                </div>


                <div class="home-blog-small-content">

                  <h3>
                    <%= blog.title %>
                  </h3>

                  <p>
                    <%= blog.content %>
                  </p>

                </div>


                <a
                  href="/blog/<%= blog._id %>"
                  class="home-blog-small-arrow"
                  aria-label="Read article"
                >
                  ↖
                </a>

              </article>

            <% }) %>

          </div>

        </div>

      <% } else { %>

        <div class="home-blog-empty">

          <h3>
            No blog posts yet
          </h3>

          <p>
            New HOMIZ stories and insights will appear here.
          </p>

        </div>

      <% } %>

    </section>


    <!-- =========================
         DESIGNERS
    ========================== -->

    <section
      class="home-designers-section"
      id="designers"
    >

      <div class="home-designers-header">

        <div class="home-designers-title">

          <p>
            OUR DESIGNERS
          </p>

          <h2>
            Meet Our Designers
          </h2>

        </div>


        <a
          href="/designers"
          class="home-designers-view-all"
        >
          View All
          <span>↖</span>
        </a>

      </div>


      <% if (
        latestDesigners &&
        latestDesigners.length > 0
      ) { %>

        <div class="home-designers-grid">

          <% latestDesigners.forEach((designer) => { %>

            <a
              href="/designers/<%= designer._id %>"
              class="home-designer-card"
            >

              <div class="home-designer-image">

                <% if (
                  designer.profileImageUrl
                ) { %>

                  <img
                    src="<%= designer.profileImageUrl %>"
                    alt="<%= designer.user ? designer.user.name : 'HOMIZ Designer' %>"
                  />

                <% } else { %>

                  <div class="home-designer-placeholder">

                    <%= designer.user
                      ? designer.user.name.charAt(0).toUpperCase()
                      : 'H'
                    %>

                  </div>

                <% } %>


                <div class="home-designer-arrow">
                  ↖
                </div>

              </div>


              <div class="home-designer-info">

                <p>
                  HOMIZ DESIGNER
                </p>

                <h3>

                  <%= designer.user
                    ? designer.user.name
                    : 'HOMIZ Designer'
                  %>

                </h3>


                <% if (
                  designer.specialization
                ) { %>

                  <span>
                    <%= designer.specialization %>
                  </span>

                <% } %>

              </div>

            </a>

          <% }) %>

        </div>

      <% } else { %>

        <div class="home-designers-empty">

          <h3>
            No designers yet
          </h3>

          <p>
            New HOMIZ designers will appear here.
          </p>

        </div>

      <% } %>

    </section>

  </main>


  <%- include('./partials/_footer.ejs') %>


  <script>
    lucide.createIcons();
  </script>

</body>
</html>