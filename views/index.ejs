<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="/stylesheets/partials.css" />
    <title>Home Page</title>
  </head>
  <body>

    <%- include('./partials/_navbar.ejs') %>

    <% if (user) { %>

      <h1>Welcome to the app, <%= user.username %>!</h1>

      <% if (profile && profile.profileImageUrl) { %>

        <img
          src="<%= profile.profileImageUrl %>"
          alt="<%= profile.user.username %>'s profile"
          width="250"
        />

      <% } %>

      <form
        action="/profile-image"
        method="POST"
        enctype="multipart/form-data"
      >

        <label for="image">Profile image</label>

        <input
          type="file"
          name="image"
          id="image"
          accept=".jpg,.jpeg,.png,.webp"
          required
        />

        <button type="submit">Upload image</button>

      </form>

    <% } else { %>

      <h1>Welcome to the Homiz platform!</h1>

    <% } %>

    <a href="/projects" class="button">View Projects</a>

    <%- include('./partials/_footer.ejs') %>
  </body>
</html>