<!DOCTYPE html>

<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/partials.css">
  <link rel="stylesheet" href="/stylesheets/blog.css">
  <title>Create Blog Post | HOMIZ</title>
</head>

<body>

  <%- include('../partials/_navbar.ejs') %>

  <main>

    <section class="blog-new">

      <div class="blog-new-header">

        <p class="blog-new-kicker">HOMIZ BLOG</p>

        <h1>Create Blog Post</h1>

        <p class="blog-new-intro">
          Share ideas, inspiration and insights about interior design.
        </p>

      </div>

      <form
        class="blog-new-form"
        action="/blog"
        method="POST"
        enctype="multipart/form-data"
      >

        <div class="blog-new-field">

          <label for="title">Title</label>

          <input
            type="text"
            id="title"
            name="title"
            placeholder="Enter article title"
            required
          >

        </div>

        <div class="blog-new-field">

          <label for="content">Content</label>

          <textarea
            id="content"
            name="content"
            placeholder="Write your article here..."
            required
          ></textarea>

        </div>

        <div class="blog-new-field">

          <label for="image">Featured Image</label>

          <input
            type="file"
            id="image"
            name="image"
            accept="image/jpeg,image/png,image/webp"
          >

        </div>

        <div class="blog-new-actions">

          <a href="/admin" class="blog-new-cancel">
            Cancel
          </a>

          <button
            type="submit"
            class="blog-new-submit"
          >
            Publish Post
            <span>→</span>
          </button>

        </div>

      </form>

    </section>

  </main>

  <%- include('../partials/_footer.ejs') %>

</body>

</html>