<!DOCTYPE html>

<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <link
    rel="stylesheet"
    href="/stylesheets/style.css"
  >

  <link
    rel="stylesheet"
    href="/stylesheets/partials.css"
  >

  <link
    rel="stylesheet"
    href="/stylesheets/blog.css"
  >

  <title><%= blog.title %> | HOMIZ</title>

</head>

<body>

  <%- include('../partials/_navbar.ejs') %>

  <main>

    <article class="blog-post">

      <header class="blog-post-header">

        <p class="blog-post-kicker">
          HOMIZ JOURNAL
        </p>

        <h1>
          <%= blog.title %>
        </h1>

      </header>


      <% if (blog.image) { %>

        <div class="blog-post-image">

          <img
            src="<%= blog.image %>"
            alt="<%= blog.title %>"
          >

        </div>

      <% } %>


      <div class="blog-post-content">

        <p>
          <%= blog.content %>
        </p>

      </div>


      <div class="blog-post-footer">

        <a
          href="/blog"
          class="blog-back-button"
        >
          <span>←</span>
          Back to Blog
        </a>

      </div>

    </article>

  </main>


  <%- include('../partials/_footer.ejs') %>

</body>

</html>