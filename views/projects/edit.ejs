<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="/stylesheets/partials.css" />
    <title>Edit project page</title>
</head>
<body>

    <%- include('../partials/_navbar.ejs') %>

    <h1>Edit Project</h1>

<form action="/projects/<%= project._id %>?_method=PUT" method="POST">

  <label>Title</label>
  <input type="text" name="title" value="<%= project.title %>">

  <label>Description</label>
  <textarea name="description"><%= project.description %></textarea>

  <label>Category</label>
  <input type="text" name="category" value="<%= project.category %>">

  <label>Location</label>
  <input type="text" name="location" value="<%= project.location %>">

  <label>Services</label>

<% services.forEach(service => { %>
  <div>
    <input
      type="checkbox"
      name="services"
      value="<%= service._id %>"
      <%= project.services.some(projectService => projectService._id.toString() === service._id.toString()) ? 'checked' : '' %>
    >
    <label><%= service.name %></label>
  </div>
<% }) %>

  <label>Current Image</label>

<img src="<%= project.image %>" alt="<%= project.title %>">

<label>Image URL</label>
<input
  type="url"
  name="image"
  value="<%= project.image %>"
  required
>

  <button type="submit">Update Project</button>

</form>

<a href="/projects/<%= project._id %>" class="button">Back</a>
    
</body>
</html>