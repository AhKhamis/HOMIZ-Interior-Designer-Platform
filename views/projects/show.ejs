<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/partials.css">
  <script src="https://unpkg.com/lucide@latest"></script>
  <title>HOMIZ | <%= project.title %></title>
</head>
<body>

  <%- include('../partials/_navbar.ejs') %>

  <main>
    <section class="project-details">

      <div class="project-details-header">
        <p>HOMIZ PROJECT</p>
        <h1><%= project.title %></h1>

        <div class="project-meta">
          <span><%= project.category %></span>
          <span><%= project.location %></span>
        </div>
      </div>

      <div class="project-main-image">
        <% if (project.mainImage && project.mainImage.url) { %>
          <img
            src="<%= project.mainImage.url %>"
            alt="<%= project.title %>"
          >
        <% } else { %>
          <div class="project-no-image">
            No main image
          </div>
        <% } %>
      </div>

      <% if (project.galleryImages && project.galleryImages.length > 0) { %>
        <div class="project-gallery-thumbnails">
          <% project.galleryImages.forEach((image, index) => { %>
            <div class="project-gallery-thumbnail">
              <img
                src="<%= image.url %>"
                alt="<%= project.title %> image <%= index + 1 %>"
              >
            </div>
          <% }) %>
        </div>
      <% } %>

      <div class="project-details-content">

        <div class="project-description">
          <p class="project-label">ABOUT THE PROJECT</p>

          <h2><%= project.title %></h2>

          <p>
            <%= project.description %>
          </p>
        </div>

        <% if (project.services && project.services.length > 0) { %>
          <div class="project-services">
            <p class="project-label">SERVICES</p>

            <div class="services-list">
              <% project.services.forEach(service => { %>
                <span class="service-tag">
                  <%= service.name %>
                </span>
              <% }) %>
            </div>
          </div>
        <% } %>

      </div>

      <div class="project-details-actions">
        <a
          href="/projects"
          class="project-button"
        >
          Back to Projects
          <span>←</span>
        </a>
      </div>

    </section>
  </main>

  <%- include('../partials/_footer.ejs') %>

  <script>
    lucide.createIcons();
  </script>

</body>
</html>