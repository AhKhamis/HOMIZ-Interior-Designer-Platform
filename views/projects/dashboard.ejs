<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="/stylesheets/partials.css" />
    <title>Dashboard</title>
</head>
<body>

    <%- include('../partials/_navbar.ejs') %>

<h1>Dashboard</h1>

<% if (designer) { %>

  <h2>
    Welcome, <%= designer.user.name %>
  </h2>

  <h3>Designer Profile</h3>

  <p>
    <strong>Bio:</strong>
    <%= designer.bio || 'No bio added yet.' %>
  </p>

  <p>
    <strong>Specialization:</strong>
    <%= designer.specialization || 'No specialization added yet.' %>
  </p>

  <a href="/designers/profile/edit">Edit Profile</a>

<% } %>

<h2>My Projects</h2>

<% if (projects.length > 0) { %>

  <% projects.forEach(project => { %>

    <div>
      <h3><%= project.title %></h3>
      <p><%= project.description %></p>

      <a href="/projects/<%= project._id %>">View</a>
      <a href="/projects/<%= project._id %>/edit">Edit</a>
    </div>

  <% }) %>

<% } else { %>

  <p>You don't have any projects yet.</p>

<% } %>

<a href="/projects/new">Add Project</a>
    
</body>
</html>