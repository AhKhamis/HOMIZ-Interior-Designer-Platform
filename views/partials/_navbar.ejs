<nav id="navbar">

  <a href="/" class="logo">
    <img src="/stylesheets/images/homiz-logo.png" alt="HOMIZ">
  </a>

  <div class="nav-links">
    <a href="/" class="nav-link">Home</a>
    <a href="/#services" class="nav-link">Services</a>
    <a href="/projects" class="nav-link">Projects</a>
    <a href="/designers" class="nav-link">Designers</a>

    <a href="/blog" class="nav-link">Blog</a>

  </div>

  <div class="auth-links">
    <% if (user) { %>

      <% if (user.role === 'admin') { %>

        <a
          href="/admin"
          class="nav-link dashboard-button"
        >
          Admin Dashboard
        </a>

        <a
          href="/auth/sign-out"
          class="nav-link"
        >
          Sign Out
        </a>

      <% } else { %>

        <a
          href="/projects/dashboard"
          class="nav-link dashboard-button"
        >
          Dashboard
        </a>

        <a
          href="/auth/sign-out"
          class="nav-link"
        >
          Sign Out
        </a>

      <% } %>

    <% } else { %>

      <a
        href="/auth/sign-up"
        class="nav-link"
      >
        Sign Up
      </a>

      <a
        href="/auth/sign-in"
        class="nav-link"
      >
        Sign In
      </a>

    <% } %>
  </div>

</nav>